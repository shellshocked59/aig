# Optional: copy to .env at the repository root and change only what you need.
# Non-empty process environment variables override this file.
# Defaults live in backend/aig/settings.py; no .env is required.
# Laragon hosting is configured in config/laragon/; see docs/laragon.md.
# Docker provides PostgreSQL and Redis; the game does not use them yet.
# ---------------------------------------------------------------------------
# AI strategy provider
# ---------------------------------------------------------------------------
# Provider used for normal application/browser AI play (Human vs Configured AI).
# Options: heuristic, ollama, openai.
# Default stays heuristic so a fresh checkout makes no external AI calls.
AIG_STRATEGY_PROVIDER=heuristic
# Planner artifact: empty/latest resolves to the concrete latest; v1 pins history.
AIG_STRATEGY_PROMPT_VERSION=latest

# Ollama configuration (does not select Ollama).
# The LAN host below is the intentional, non-secret development default.
AIG_OLLAMA_BASE_URL=http://10.0.0.250:11434
AIG_OLLAMA_MODEL=hf.co/empero-ai/Qwen3.8-4B-Distill-GGUF:Q4_K_M
AIG_OLLAMA_CONTEXT_SIZE=4096
AIG_OLLAMA_TEMPERATURE=0
AIG_OLLAMA_SEED=42
AIG_OLLAMA_MAX_OUTPUT_TOKENS=256
AIG_OLLAMA_KEEP_ALIVE=10m
AIG_OLLAMA_THINK=false
AIG_OLLAMA_STREAM=false
AIG_OLLAMA_TIMEOUT_SECONDS=20
# Optional OpenAI cloud strategy provider (Python backend only).
# Configuring OPENAI_API_KEY does not select OpenAI.
# Put your real key in the ignored local/server environment file.
# A key is required only when the OpenAI provider is explicitly selected.
OPENAI_API_KEY=
AIG_OPENAI_MODEL=gpt-5.6-luna
AIG_OPENAI_TIMEOUT_SECONDS=20
AIG_OPENAI_MAX_OUTPUT_TOKENS=512
AIG_OPENAI_REASONING_EFFORT=none

# Conventional AI orchestration (positive integers)
AIG_AI_REPLAN_INTERVAL=5
AIG_AI_MAX_ACTIONS=256

# Frontend build: empty uses same-origin /api/ (Node dev server or Apache proxy).
# For the separate local API hostname, set http://api.aig.localhost.
# Production build: https://api.agentstrategy.online.
PUBLIC_API_BASE_URL=
# Comma-separated frontend origins allowed by Python (no trailing slashes).
# Production backend: https://www.agentstrategy.online.
AIG_HTTP_CORS_ORIGINS=http://aig.localhost

# Optional Docker development settings (see docs/docker.md).
# Use WEB_BIND rather than an AIG_ prefix: these are Compose settings.
WEB_BIND=127.0.0.1:5173
# Matches the existing Laragon Apache /api/ proxy. Stop host Python first.
API_BIND=127.0.0.1:8000
POSTGRES_DB=aig
POSTGRES_USER=aig
POSTGRES_PASSWORD=aig-dev
# For Ollama on the Docker Desktop host, override AIG_OLLAMA_BASE_URL above
# with http://host.docker.internal:11434. No model server runs in Compose.
