# Optional: copy to .env at the repository root and change only what you need.
# Non-empty process environment variables override this file.
# Defaults live in backend/aig/settings.py; no .env is required.
# The LAN host below is the intentional, non-secret development default.
AIG_OLLAMA_BASE_URL=http://10.0.0.250:11434
AIG_OLLAMA_MODEL=hf.co/empero-ai/Qwen3.8-4B-Distill-GGUF:Q4_K_M
AIG_OLLAMA_CONTEXT_SIZE=4096
AIG_OLLAMA_TEMPERATURE=0
AIG_OLLAMA_SEED=42
AIG_OLLAMA_MAX_OUTPUT_TOKENS=256
AIG_OLLAMA_KEEP_ALIVE=10m
AIG_OLLAMA_THINK=false
